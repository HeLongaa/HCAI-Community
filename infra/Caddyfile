{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	handle /gateway-healthz {
		header Content-Type application/json
		respond `{\"status\":\"ok\",\"service\":\"hcai-gateway\"}` 200
	}

	handle /api/* {
		reverse_proxy api:8787
	}

	handle /health {
		reverse_proxy api:8787
	}

	handle {
		reverse_proxy frontend:4173
	}
}

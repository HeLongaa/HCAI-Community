{
  "name": "hcai-community-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "start:e2e": "node src/index.js",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "minimax-video:provision:staging": "node --env-file-if-exists=.env src/modelControl/minimaxVideoStagingProvisioningCli.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "file-type": "^21.3.4",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.0",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  }
}
